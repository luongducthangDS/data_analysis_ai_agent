# ── LLM Provider — auto fallback: Gemini → OpenRouter (nhiều model free) ──
# LLM_PROVIDER=auto   # auto (mặc định) | gemini | openrouter

# Gemini (primary). Lấy key tại: https://aistudio.google.com/apikey
# Key phụ (tuỳ chọn). Quota free tier tính riêng cho từng cặp (key, model)
# — 15 request/phút mỗi model mỗi key — nên khai thêm key là nhân đôi hạn mức.
# Chuỗi failover sẽ thử key2 trên cùng model trước khi hạ xuống model kế.
GEMINI_API_KEY2=
GEMINI_API_KEY=
GOOGLE_API_KEY=
# Chuỗi model (comma-separated), thử lần lượt khi 429/lỗi. Trống = default:
#   gemini-3.5-flash-lite (free RPD 500), gemini-3.8-flash, gemini-3.6-flash (RPD 20)
GEMINI_MODELS=

# OpenRouter (fallback). Lấy key: https://openrouter.ai/keys
# Khi Gemini sập, thử lần lượt từng model trong OPENROUTER_MODELS.
OPENROUTER_API_KEY=
# comma-separated; trống = default: nvidia/nemotron-3-super-120b-a12b:free,
#   google/gemma-4-31b-it:free, nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_MODELS=

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (local dev — no setup needed, file created automatically)
# DATABASE_URL=sqlite:///./data/sessions.db
# PostgreSQL (production). Supabase: dùng URI "Session pooler" (Connect → Session pooler)
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ── Auth ─────────────────────────────────────────────────────────────────────
# ALLOW_NO_AUTH=true  → no auth required (local dev / demo)
# ALLOW_NO_AUTH=false → require X-API-Key header (production)
ALLOW_NO_AUTH=true
# Comma-separated API keys (only used when ALLOW_NO_AUTH=false)
# API_KEYS=key1,key2,key3

# ── CORS ──────────────────────────────────────────────────────────────────────
# "*" allows all origins (fine for local dev).
# Set to your production domain for security, e.g.: https://myapp.onrender.com
ALLOWED_ORIGINS=*

# ── App ───────────────────────────────────────────────────────────────────────
PORT=8000
# DATA_DIR: root folder for uploads/ and reports/ subdirectories.
# On Render/Railway: set to the persistent volume mount path (e.g. /data).
# Locally: leave unset → defaults to "data/" relative to project root.
# DATA_DIR=/data

# ── Session cleanup ───────────────────────────────────────────────────────────
# Sessions older than this many days are automatically deleted.
SESSION_TTL_DAYS=7

# ── Báo cáo Telegram (python -m scripts.send_telegram_report ...) ─────────────
# Tạo bot: nhắn @BotFather → /newbot → lấy token.
# Lấy chat_id: nhắn bot 1 tin, mở https://api.telegram.org/bot<TOKEN>/getUpdates → "chat":{"id":...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
